# =========================
# ABYSSGPT BACKEND (Render)
# =========================
PORT=10000
NODE_ENV=production
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app

# AI Credits API — the ONLY AI provider used by this project
AICREDITS_API_KEY=your_ai_credits_key
AICREDITS_BASE_URL=https://api.aicredits.com/v1
# MODEL_ID is an OPAQUE configuration value. The agent stack is fully
# model-agnostic: change this to any compatible tool-calling model and the
# same orchestration (search / read / code execution / verification)
# continues to work. Never reference a specific model name in code.
MODEL_ID=your_single_model_id

# Tavily (optional; only used when Web Search is enabled)
TAVILY_API_KEY=

# Firebase Admin SDK / Firestore
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=(default)

# First admin bootstrap email
ADMIN_EMAIL=your-admin-email@example.com

# Premium
PREMIUM_PRICE_INR=299
TELEGRAM_USERNAME=@MrNewton_2
DEFAULT_SYSTEM_PROMPT=You are AbyssGPT, a capable, direct, analytical conversational AI assistant.

# =========================
# VERCEL FRONTEND VARIABLES
# =========================
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# Admin panel password (server-only Render secret)
ADMIN_PASSWORD=change-this-to-a-strong-secret
ADMIN_SESSION_TTL_SECONDS=43200

# =========================
# AUTOMATIC AGENT RESOURCE MANAGEMENT (server-side only — never set in Vercel)
# =========================
# These are the ABSOLUTE SERVER HARD CEILINGS. The automatic budget planner
# classifies every request (simple / current-info / research / coding), generates
# a per-request budget below these ceilings, and the backend enforces them no
# matter what the model requests. Users never configure or see these values.
# Lowering them makes the agent cheaper/faster; they can never be raised beyond
# the code-level absolute maxima.
MAX_AGENT_STEPS=12              # max reasoning/planning rounds per request
MAX_TOOL_CALLS=16               # max total tool invocations per request
MAX_TOOL_OUTPUT_SIZE=30000      # max characters per tool result fed to the model
TOOL_TIMEOUT_MS=45000           # max wall-clock per individual tool call
TOTAL_AGENT_TIMEOUT_MS=180000   # max wall-clock for the whole agentic request
MAX_SEARCH_RESULTS=8            # max Tavily results per search
MAX_WEBPAGE_SIZE=50000          # max characters per webpage read
MAX_CODE_EXECUTION_TIME_MS=60000 # max Daytona sandbox time per run
