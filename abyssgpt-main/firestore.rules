rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AbyssGPT uses Firebase Admin SDK on the backend for all application data.
    // The browser only needs Firebase Authentication, so direct client-side
    // Firestore reads/writes stay disabled.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
